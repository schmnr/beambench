#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: scripts/harden-linux-appimage [--check] <path-to-AppImage>" >&2
}

mode="repair"
if [ "${1:-}" = "--check" ]; then
  mode="check"
  shift
fi

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

appimage="$1"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$appimage" ]; then
  echo "AppImage not found: $appimage" >&2
  exit 1
fi

for command_name in grep mksquashfs unsquashfs; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Required command not found: $command_name" >&2
    exit 1
  fi
done

work_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

find_squashfs_offset() {
  local candidate
  while IFS=: read -r candidate _; do
    if unsquashfs -s -o "$candidate" "$appimage" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done < <(LC_ALL=C grep -aob 'hsqs' "$appimage")
  echo "Could not locate the AppImage SquashFS payload." >&2
  return 1
}

extract_appimage() {
  local destination="$1"
  unsquashfs -q -no-progress -o "$squashfs_offset" -d "$destination" "$appimage"
}

find_incompatible_libraries() {
  local app_dir="$1"
  find "$app_dir/usr/lib" \( -type f -o -type l \) \( \
    -name 'libwayland-*.so*' -o \
    -name 'libglib-2.0.so*' -o \
    -name 'libgio-2.0.so*' -o \
    -name 'libgobject-2.0.so*' -o \
    -name 'libgmodule-2.0.so*' -o \
    -name 'libgst*.so*' -o \
    -name 'libmount.so*' -o \
    -name 'libblkid.so*' -o \
    -name 'libselinux.so*' -o \
    -name 'libpcre2-8.so*' -o \
    -name 'libzstd.so*' -o \
    -name 'libelf.so*' -o \
    -name 'libffi.so*' \
  \) -print
}

squashfs_offset="$(find_squashfs_offset)"
extracted_dir="$work_dir/AppDir"
extract_appimage "$extracted_dir"

runtime_dir="$extracted_dir/usr/share/beambench"
gtk_hook="$extracted_dir/apprun-hooks/linuxdeploy-plugin-gtk.sh"
runtime_hook='source "$APPDIR/usr/share/beambench/linux-runtime.sh"'

runtime_policy_matches() {
  [ -f "$gtk_hook" ] &&
    grep -Fxq "$runtime_hook" "$gtk_hook" &&
    ! grep -q '^export GDK_BACKEND=x11' "$gtk_hook" &&
    cmp -s "$script_dir/linux-appimage-runtime.sh" "$runtime_dir/linux-runtime.sh" &&
    cmp -s "$script_dir/linux-appimage-fonts.conf" "$runtime_dir/fonts.conf"
}

mapfile -t incompatible_libraries < <(find_incompatible_libraries "$extracted_dir")
if [ "$mode" = "check" ]; then
  if [ "${#incompatible_libraries[@]}" -ne 0 ]; then
    printf 'AppImage contains host-incompatible runtime libraries:\n' >&2
    printf '  %s\n' "${incompatible_libraries[@]}" >&2
    exit 1
  fi
  if ! runtime_policy_matches; then
    echo "AppImage is missing the current display and color-font compatibility policy." >&2
    exit 1
  fi
  echo "AppImage runtime library and compatibility audit passed: $appimage"
  exit 0
fi

if [ "${#incompatible_libraries[@]}" -eq 0 ] && runtime_policy_matches; then
  echo "AppImage runtime libraries and compatibility policy are already current."
  exit 0
fi

printf 'Removing %d host-incompatible runtime libraries.\n' "${#incompatible_libraries[@]}"
rm -f -- "${incompatible_libraries[@]}"

if [ ! -f "$gtk_hook" ]; then
  echo "AppImage is missing the generated GTK launcher hook." >&2
  exit 1
fi
if grep -q '^export GDK_BACKEND=x11' "$gtk_hook"; then
  sed -i '/^export GDK_BACKEND=x11/c\source "$APPDIR/usr/share/beambench/linux-runtime.sh"' "$gtk_hook"
elif ! grep -Fxq "$runtime_hook" "$gtk_hook"; then
  echo "Unrecognized GTK launcher hook; refusing to leave display selection unpatched." >&2
  exit 1
fi
mkdir -p "$runtime_dir"
cp "$script_dir/linux-appimage-runtime.sh" "$runtime_dir/linux-runtime.sh"
cp "$script_dir/linux-appimage-fonts.conf" "$runtime_dir/fonts.conf"
if ! runtime_policy_matches; then
  echo "Failed to install the AppImage compatibility policy." >&2
  exit 1
fi

remaining="$(find_incompatible_libraries "$extracted_dir" | head -n 1)"
if [ -n "$remaining" ]; then
  echo "Failed to remove incompatible library: $remaining" >&2
  exit 1
fi

rebuilt_squashfs="$work_dir/AppDir.squashfs"
mksquashfs "$extracted_dir" "$rebuilt_squashfs" \
  -noappend \
  -all-root \
  -no-xattrs \
  -comp zstd \
  -b 131072 \
  -mkfs-time 0 \
  -no-progress \
  -quiet

rebuilt_appimage="$work_dir/rebuilt.AppImage"
dd if="$appimage" of="$rebuilt_appimage" bs=1 count="$squashfs_offset" status=none
cat "$rebuilt_squashfs" >> "$rebuilt_appimage"
chmod --reference="$appimage" "$rebuilt_appimage"
mv "$rebuilt_appimage" "$appimage"

# The updater signature was created for the pre-repair binary and is invalid.
# The release workflow signs the repaired artifact immediately after this step.
rm -f "${appimage}.sig"

echo "Hardened AppImage runtime libraries, display selection, and font policy: $appimage"
